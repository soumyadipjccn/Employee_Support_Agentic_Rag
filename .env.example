# NVIDIA / OpenAI-Compatible LLM Configuration
# To use NVIDIA NIM models (e.g., meta/llama-3.3-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct):
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.3-70b-instruct

# OpenAI API Key (Alternative if not using NVIDIA NIM)
# OPENAI_API_KEY=sk-your-openai-api-key

# Embedding Model Configuration (E5-Small)
# Options: "intfloat/e5-small-v2", "intfloat/multilingual-e5-small", "nvidia/e5-small-v2"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/e5-small-v2

# Vector Database (Pinecone) Configuration
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=fde-hr-policy-rag
PINECONE_NAMESPACE=company-hr-kb

# Web Search API (Tavily)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Admin Key for Document Ingestion API
ADMIN_API_KEY=change-me-in-production
